// TASLAK — Aşama 3'te kullanılacak. Aşama 1'de projeye bağlı değildir.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  tokens       Int      @default(0)
  shooterId    String?
  createdAt    DateTime @default(now())
  tasos        OwnedTaso[]
}

model Series {
  id       String         @id
  name     String
  catalog  CatalogTaso[]
}

model CatalogTaso {
  id        String  @id
  seriesId  String
  number    Int
  name      String
  form      String?
  rarity    String
  imageUrl  String?
  series    Series  @relation(fields: [seriesId], references: [id])
  owned     OwnedTaso[]

  @@unique([seriesId, number])
}

model OwnedTaso {
  id         String   @id @default(cuid())
  userId     String
  catalogId  String
  level      Int      @default(1)
  xp         Int      @default(0)
  locked     Boolean  @default(false)
  favorite   Boolean  @default(false)
  inMatchId  String?  // aynı taso iki maçta kullanılamaz
  user       User        @relation(fields: [userId], references: [id])
  catalog    CatalogTaso @relation(fields: [catalogId], references: [id])

  @@index([userId])
}
